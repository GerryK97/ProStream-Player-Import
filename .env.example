# Required: same PostgreSQL database used by ProStream Scoreboard
DATABASE_URL=postgresql://user:password@host:5432/database

# Required: random secret with at least 32 characters
SESSION_SECRET=replace-with-a-long-random-secret

# Defaults to Admin. Comma-separate additional Scoreboard roles only if needed.
IMPORT_ALLOWED_ROLES=Admin

SCOREBOARD_URL=https://score.prostream.lk
DATABASE_POOL_MAX=5

# Optional source overrides and polite request intervals
CRICHEROES_API_KEY=cr!CkH3r0s
CRICHEROES_MIN_INTERVAL_MS=250
STUMPS_API_BASE=https://gateway.stumpsapp.com
STUMPS_MIN_INTERVAL_MS=250
